[Unit]
Description=Speech Panel dotool Wayland typing daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/home/morton/.local/bin/dotoold
Environment=PATH=/home/morton/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
